# --- Server (apps/server) ---
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
APP_KEY=generate-with-node-ace-generate-key
LOG_LEVEL=info

# MongoDB (adonis-odm)
MONGO_URI=mongodb://localhost:27017/reqtap
REQTAP_STORAGE=mongo
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
AUTH_REQUIRED=false

# Public base URL used to build endpoint URLs (https://reqtap.dev/t/<token>)
APP_URL=http://localhost:3333
WEB_URL=http://localhost:3000

# Optional SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Web (apps/web) ---
NUXT_PUBLIC_API_BASE=http://localhost:3333
